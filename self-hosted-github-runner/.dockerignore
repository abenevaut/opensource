# .dockerignore — excludes files that don't need to be in the build context.
# This speeds up `docker build` and avoids accidentally including secrets.

# ── Secrets / runtime config ───────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Runner credentials (generated at runtime, should never be in image) ────────
.credentials
.credentials.rsaparams
.runner

# ── Spec / documentation (not needed in image) ────────────────────────────────
specs/
*.md
!README.md

# ── Git and CI metadata ────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Editor / OS artifacts ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
*.swp

# ── Test artifacts ─────────────────────────────────────────────────────────────
_diag/
*.log

# ── The .specify directory (speckit metadata) ──────────────────────────────────
.specify/

