# Copy this file to .env and fill in the values.
# cp .env.example .env

# ⚠️ AMD64 ONLY. ARM64 is not supported. See README.md.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# GitHub organization name (or owner name for repo-level runners).
# REQUIRED. The placeholder value below causes an immediate startup failure.
ORGANIZATION=<YOUR-GITHUB-ORGANIZATION>

# GitHub Personal Access Token with:
#   Org-level  : admin:org (classic PAT) or "Self-hosted runners: Read & write" (fine-grained)
#   Repo-level : repo (classic PAT)      or "Administration: Read & write" (fine-grained)
# REQUIRED. The placeholder value below causes an immediate startup failure.
ACCESS_TOKEN=<YOUR-GITHUB-ACCESS-TOKEN>

# ─────────────────────────────────────────────────────────────────────────────
# RUNNER DIRECTORY  (DooD constraint: host path MUST equal container path)
# ─────────────────────────────────────────────────────────────────────────────
# The runner directory is bind-mounted into the container. The host path and the
# container path MUST be identical — the host Docker daemon resolves bind-mount
# sources on the HOST filesystem when running container:/services: jobs.
#
# Linux (default — works out of the box):
#   sudo mkdir -p /home/docker/actions-runner
# RUNNER_DIR=/home/docker/actions-runner
#
# Synology DSM — /home/docker is NOT a real host path; use /volume1/...:
#   sudo mkdir -p /volume1/docker/actions-runner
# RUNNER_DIR=/volume1/docker/actions-runner

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — runner configuration
# ─────────────────────────────────────────────────────────────────────────────

# Target a specific repository instead of the whole organization.
# Leave empty (default) for an org-level runner.
# REPOSITORY=my-repo

# Display name shown in GitHub Actions → Settings → Runners.
# Default: container hostname (auto-generated by Docker).
# RUNNER_NAME=runner-01

# Comma-separated labels for runs-on: targeting.
# Default: self-hosted,linux,x64
# RUNNER_LABELS=self-hosted,linux,x64,docker

# Job workspace sub-directory (relative to RUNNER_DIR).
# Default: _work
# RUNNER_WORKDIR=_work

# Ephemeral mode: the runner deregisters after a single job, then the container
# exits. Docker Compose (restart: always) immediately starts a fresh instance.
# Strongly recommended: prevents cross-job secret leakage.
# Default: true
# EPHEMERAL=true

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — private image authentication (DA-08)
# ─────────────────────────────────────────────────────────────────────────────
# Required when workflows use `container:` or `services:` with private registry
# images (e.g., ghcr.io/your-org/your-image:tag). Without credentials, the
# Pre Job Hook fails with exit code 1 (Worker exit code 102).
#
# OPTION B — GHCR token (simpler, GHCR only):
#   entrypoint.sh Phase 1 runs `docker login ghcr.io` using these values.
#   GHCR_USER must be your GitHub username or "x-token" for PAT auth.
# GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GHCR_USER=your-github-username
#
# OPTION A — host Docker config directory (recommended, registry-agnostic):
#   Set DOCKER_CONFIG_HOST to the directory containing config.json on the host.
#   Then uncomment the volume mount in docker-compose.yml:
#     - ${DOCKER_CONFIG_HOST}:/home/docker/.docker:ro
# DOCKER_CONFIG_HOST=/root/.docker
#
# If NEITHER option is set, public images work fine but private images fail.

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — advanced networking
# ─────────────────────────────────────────────────────────────────────────────
# Docker network mode for containers spawned by container:/services: hooks.
# Default: bridge  (safer default, avoids host-network side-effects)
# Use host only if jobs explicitly require access to the host network stack.
# ACTIONS_RUNNER_CONTAINER_NETWORK=bridge
