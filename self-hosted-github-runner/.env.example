# Copy this file to .env and fill in the values.
# cp .env.example .env

# Platform: linux/amd64 (Intel/AMD servers) or linux/arm64 (Apple Silicon, AWS Graviton, Raspberry Pi, Synology NAS ARM)
PLATFORM=linux/amd64

# Runner directory — MUST be the same absolute path as seen by the host Docker daemon (DooD requirement).
# Linux / Synology (default, no need to set):
#   RUNNER_DIR=/home/docker/actions-runner
#   sudo mkdir -p /home/docker/actions-runner
#
# Mac (Docker Desktop only shares paths under /Users/ by default):
#   RUNNER_DIR=/Users/<you>/.gh-runner/actions-runner
#   mkdir -p ~/.gh-runner/actions-runner
# RUNNER_DIR=/home/docker/actions-runner

# Required
ORGANIZATION=<YOUR-GITHUB-ORGANIZATION>
ACCESS_TOKEN=<YOUR-GITHUB-ACCESS-TOKEN>

# Optional
# REPOSITORY=mon-repo
# RUNNER_NAME=runner-01
# RUNNER_LABELS=self-hosted,linux,x64,docker
# RUNNER_WORKDIR=_work
# EPHEMERAL=true

